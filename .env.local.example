# Create a PIBASE project, apply the schema, and copy its API credentials here.
NEXT_PUBLIC_PIBASE_URL=http://localhost:18080
NEXT_PUBLIC_PIBASE_ANON_KEY=REPLACE_ME
PIBASE_SERVICE_KEY=REPLACE_ME
STUDIO_OWNER_USER_ID=REPLACE_ME_AFTER_SIGNUP

# Must be a long random secret; changing it invalidates outstanding signing links.
CONTRACT_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BOOKING_URL=http://localhost:3000
BOOKING_HOST=booking.elliesheartstrings.com

# Encrypts API keys saved from the Settings page. Long random value; if it
# changes, keys saved in Settings must be entered again.
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET

# Optional email, payment, and monitoring integrations. These can also be
# entered in the app under Settings (saved values there take priority).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HEARTBEAT_SECRET=
