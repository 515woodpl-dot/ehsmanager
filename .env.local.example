# Required for PIBASE-backed beta. These names are retained for supabase-js
# compatibility; use the URL and keys from your PIBASE project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PIBASE-GATEWAY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PIBASE-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-PIBASE-SERVICE-KEY
STUDIO_OWNER_USER_ID=YOUR-SIGNED-UP-PIBASE-USER-ID
NEXT_PUBLIC_APP_URL=https://YOUR-APP-DOMAIN
NEXT_PUBLIC_BOOKING_URL=https://booking.elliesheartstrings.com
BOOKING_HOST=booking.elliesheartstrings.com
CONTRACT_SIGNING_SECRET=GENERATE-A-LONG-RANDOM-SECRET

# Optional: live invoice payments (keep disabled until the checkout UI is ready).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: outgoing email through a verified sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: protects /api/heartbeat from public abuse.
HEARTBEAT_SECRET=
