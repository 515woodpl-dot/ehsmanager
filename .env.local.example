# Create a PIBASE project, apply the schema, and copy its API credentials here.
NEXT_PUBLIC_PIBASE_URL=http://localhost:18080
NEXT_PUBLIC_PIBASE_ANON_KEY=REPLACE_ME
PIBASE_SERVICE_KEY=REPLACE_ME
STUDIO_OWNER_USER_ID=REPLACE_ME_AFTER_SIGNUP

# Must be a long random secret; changing it invalidates outstanding signing links.
CONTRACT_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BOOKING_URL=http://localhost:3000
BOOKING_HOST=booking.elliesheartstrings.com
# Optional fallbacks when no logo/cover is uploaded under Admin → Branding.
STUDIO_LOGO_URL=
CONTRACT_COVER_URL=

# Encrypts Resend/Stripe keys entered under Admin → Integrations (AES-256-GCM).
# Generate with: openssl rand -base64 32. Changing it makes saved keys unreadable.
INTEGRATIONS_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET

# Self-service signup stays hidden unless this is "true". Also disable signups
# in PIBASE auth settings so the auth API itself rejects new accounts.
NEXT_PUBLIC_ALLOW_SIGNUP=false

# Optional server-wide fallbacks, used ONLY for STUDIO_OWNER_USER_ID. Prefer
# entering keys under Admin → Integrations instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@elliesheartstrings.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HEARTBEAT_SECRET=
